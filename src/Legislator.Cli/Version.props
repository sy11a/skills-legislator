<Project>
  <PropertyGroup>
    <!-- The edition pins the tool version here; `legislator version` prints it back (R-8214, C-12).
         0.0.0 is the un-assigned pin: edition numbers are assigned at merge, never reserved
         (roadmap ruling at the v25 merge, ed5c069). Task 12 sets the number that is free then,
         and the static check holds `skill/VERSION` == this major from that commit on. -->
    <Version>0.0.0</Version>
    <!-- Without this the informational version carries a +<sha> suffix and stops being the pinned number. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
