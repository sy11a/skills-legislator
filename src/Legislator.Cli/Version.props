<Project>
  <PropertyGroup>
    <!-- The edition pins the tool version here; `legislator version` prints it back (R-8214, C-12).
         Assigned 2026-09-04 from freshly-fetched master, whose highest benchmark was v25 and
         whose VERSION was 25: 26 is the number that was free. Edition numbers are assigned at
         merge and never reserved (roadmap ruling at the v25 merge, ed5c069) - BL-082's own
         earlier claim on 25 is what taught the rule. `evals/check_static.py` holds
         `skill/VERSION` == this major from this commit on, so the two cannot move apart. -->
    <Version>26.0.0</Version>
    <!-- Without this the informational version carries a +<sha> suffix and stops being the pinned number. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
